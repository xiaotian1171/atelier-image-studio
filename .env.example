# Copy to .env for local development, or set these in your hosting dashboard.
# Never place a private sk_ key in this file for the published app.

# Required for real BYOP sign-in. Root origin only; no path/query/fragment.
# Example: https://atelier.your-domain.com
PUBLIC_APP_URL=

# Public OAuth App Key created at https://enter.pollinations.ai/keys
# Register exactly: ${PUBLIC_APP_URL}/auth/callback
# Example prefix: pk_... ; leave blank until you create your own App Key.
POLLINATIONS_APP_KEY=

# Suggested consent values. Users confirm/change these on Pollinations.
POLLINATIONS_BUDGET=1
POLLINATIONS_EXPIRY_DAYS=7

# Optional public links (HTTPS or mailto); never use placeholder URLs in a live submission.
PUBLIC_SOURCE_URL=
PUBLIC_CONTACT_URL=

# Keep OFF for the public catalog edition. Optional private/developer feature.
ENABLE_CUSTOM_PROVIDERS=false
# Restricts custom-provider mode only; public BYOP tokens are always pinned to Pollinations.
ALLOWED_API_HOSTS=gen.pollinations.ai,api.openai.com

# Set to 1 ONLY behind exactly one trusted reverse proxy that overwrites forwarding headers.
TRUST_PROXY_HOPS=0
PORT=3000
